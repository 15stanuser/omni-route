# Omni Route Environment Variables
PORT=3000

# Route configurations (comma-separated path=target pairs)
# Example: ROUTES=/api/service1=https://service1.com,/api/service2=https://service2.com
ROUTES=

# Default service URLs (used if not overridden by ROUTES)
KIMI_CODE_URL=https://kimi-code-server.onrender.com
PENTARACT_URL=https://pentaract-i2os.onrender.com
